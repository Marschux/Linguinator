# Model and runtime
LINGUMACHINA_MODEL=facebook/nllb-200-distilled-600M
LINGUMACHINA_DEVICE=cpu
LINGUMACHINA_MAX_CHARS=6000
LINGUMACHINA_MAX_FILE_MB=50
LINGUMACHINA_CPU_THREADS=0
LINGUMACHINA_CPU_INTEROP_THREADS=0

# History
LINGUMACHINA_HISTORY_DAYS=7
LINGUMACHINA_HISTORY_DIR=/data/history

# Queue
LINGUMACHINA_JOB_WORKERS=1
LINGUMACHINA_JOBS_DIR=/data/history/jobs

# Default languages
LINGUMACHINA_DEFAULT_SOURCE=eng_Latn
LINGUMACHINA_DEFAULT_TARGET=deu_Latn

# OCR
LINGUMACHINA_INSTALL_OCR=false
LINGUMACHINA_ENABLE_OCR=false
LINGUMACHINA_OCR_LANGUAGE=deu+eng

# Basic auth
LINGUMACHINA_AUTH_ENABLED=false
LINGUMACHINA_AUTH_USERNAME=admin
LINGUMACHINA_AUTH_PASSWORD=changeme

# Reverse proxy
LINGUMACHINA_ROOT_PATH=
LINGUMACHINA_PUBLIC_URL=
LINGUMACHINA_TRUST_PROXY_HEADERS=true
LINGUMACHINA_FORWARDED_ALLOW_IPS=*

# Direct HTTPS, optional
LINGUMACHINA_SSL_CERTFILE=
LINGUMACHINA_SSL_KEYFILE=

# Idle memory handling
LINGUMACHINA_UNLOAD_MODEL_AFTER_IDLE=true
LINGUMACHINA_MODEL_IDLE_SECONDS=1200
