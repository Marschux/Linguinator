# Model and runtime
# Another model can carry another licence; the README's licensing section describes this one.
LINGUINATOR_MODEL=Helsinki-NLP/opus-mt-tc-bible-big-mul-mul
LINGUINATOR_MODEL_CACHE_SIZE=1
# cuda belongs to the linguinator-gpu service, which sets it itself and holds the GPU
# reservation. Setting it here does not give the normal service a GPU.
LINGUINATOR_DEVICE=cpu
# Characters per chunk. Not a model limit: chunks are split into single sentences before
# translation. Governs peak memory per model call and how finely progress advances.
LINGUINATOR_MAX_CHARS=2000
LINGUINATOR_MAX_FILE_MB=50
LINGUINATOR_CPU_THREADS=0
LINGUINATOR_CPU_INTEROP_THREADS=0

# History
LINGUINATOR_HISTORY_DAYS=7
LINGUINATOR_HISTORY_DIR=/data/history
LINGUINATOR_TIMEZONE=UTC
# auto (follows UI language), 12h, or 24h
LINGUINATOR_TIME_FORMAT=auto

# Queue
LINGUINATOR_JOB_WORKERS=1

# Default languages
LINGUINATOR_DEFAULT_SOURCE=eng_Latn
LINGUINATOR_DEFAULT_TARGET=deu_Latn

# Favourites at the top of both language pickers, at most three; English is always added.
LINGUINATOR_FAVORITE_LANGUAGES=deu_Latn,spa_Latn,fra_Latn

# OCR is always on when pdftoppm/tesseract are installed, no toggle and no language setting:
# it reads in the source language picked for the job, and finds that language itself when the
# source is set to auto-detect. See /health for what the image can read.

# PDF font, empty uses DejaVu Sans from the image
LINGUINATOR_PDF_FONT=
LINGUINATOR_PDF_FONT_BOLD=

# How many layout-PDF paragraphs are translated in one model call
LINGUINATOR_PDF_LAYOUT_BATCH_SIZE=4

# Basic auth. Leave the password empty until you set a real one: with auth enabled and no
# password the app answers 500, which is noisy but safe. A placeholder from a public example
# file is neither.
LINGUINATOR_AUTH_ENABLED=false
LINGUINATOR_AUTH_USERNAME=admin
LINGUINATOR_AUTH_PASSWORD=

# Reverse proxy
LINGUINATOR_ROOT_PATH=
LINGUINATOR_TRUST_PROXY_HEADERS=true
# "*" lets anyone reaching the container directly set X-Forwarded-For to anything. Nothing here
# decides by client IP, so it costs nothing today; narrow it to the proxy if you publish the port.
LINGUINATOR_FORWARDED_ALLOW_IPS=*

# Direct HTTPS, optional
LINGUINATOR_SSL_CERTFILE=
LINGUINATOR_SSL_KEYFILE=

# Idle memory handling
LINGUINATOR_UNLOAD_MODEL_AFTER_IDLE=true
LINGUINATOR_MODEL_IDLE_SECONDS=1200
