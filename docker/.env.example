# Runtime
LINGUINATOR_MAX_FILE_MB=50
# Torch, OMP and MKL threads. 0 keeps the library defaults, which take every core
LINGUINATOR_CPU_THREADS=0
# Seconds of idleness before the loaded model is dropped from memory.
LINGUINATOR_MODEL_IDLE_SECONDS=600

# History
LINGUINATOR_HISTORY_DAYS=7
# IANA name, e.g. Europe/Berlin, America/New_York. Display only, stored times are UTC.
LINGUINATOR_TIMEZONE=Europe/Berlin
# 12h or 24h, the same for every UI language.
LINGUINATOR_TIME_FORMAT=24h

# Languages
# UI language a fresh browser starts with. One of: en = English, de = German, es = Spanish, fr = French
LINGUINATOR_UI_LANGUAGE=en
LINGUINATOR_DEFAULT_TARGET=eng_Latn
LINGUINATOR_FAVORITE_LANGUAGES=deu_Latn,spa_Latn,fra_Latn

# Basic auth
LINGUINATOR_AUTH_ENABLED=false
LINGUINATOR_AUTH_USERNAME=Translator
LINGUINATOR_AUTH_PASSWORD=changeme

# Reverse proxy
# Path prefix when the app is served below one, e.g. /linguinator. Empty for its own subdomain.
LINGUINATOR_ROOT_PATH=
