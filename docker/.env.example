# Runtime
LINGUINATOR_MAX_FILE_MB=50
# Torch, OMP and MKL threads. 0 keeps the library defaults, which take every core; set a number
# when the container shares its host with other services.
LINGUINATOR_CPU_THREADS=0
# Seconds of idleness before the loaded model is dropped from memory. It reloads on the next
# job, which costs a few seconds. 0 keeps it loaded for good.
LINGUINATOR_MODEL_IDLE_SECONDS=600

# History
LINGUINATOR_HISTORY_DAYS=7
# IANA name, e.g. Europe/Berlin, America/New_York. Display only, stored times are UTC.
LINGUINATOR_TIMEZONE=Europe/Berlin
# 12h or 24h, the same for every UI language.
LINGUINATOR_TIME_FORMAT=24h

# Languages
# UI language a fresh browser starts with: en, de, es, fr. A browser that has been switched by
# hand keeps its own choice.
LINGUINATOR_UI_LANGUAGE=en
# Preselected target language. The source starts on auto-detect and is not configurable.
LINGUINATOR_DEFAULT_TARGET=eng_Latn
# Favourites at the top of both language pickers, at most three; English is always added.
LINGUINATOR_FAVORITE_LANGUAGES=deu_Latn,spa_Latn,fra_Latn

# Basic auth
LINGUINATOR_AUTH_ENABLED=false
LINGUINATOR_AUTH_USERNAME=Translator
LINGUINATOR_AUTH_PASSWORD=changeme

# Reverse proxy
# Path prefix when the app is served below one, e.g. /linguinator. Empty for its own subdomain.
LINGUINATOR_ROOT_PATH=
LINGUINATOR_TRUST_PROXY_HEADERS=true
